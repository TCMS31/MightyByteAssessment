# Copy to .env for local development. Every value below has a working default,
# except JWT_SECRET in production, where the server refuses to start without it.

# HTTP port for the API and both Socket.IO namespaces.
PORT=3001

# development | production | test
NODE_ENV=development

# Signing key for access tokens. REQUIRED when NODE_ENV=production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Access token lifetime, in seconds. Drives both the JWT `exp` claim and the
# server-side revocation record.
JWT_EXPIRY_SECONDS=300

# Comma-separated list of browser origins allowed to call the API and open sockets.
CORS_ORIGINS=http://localhost:3000

# A driver is "online" while their last fix is newer than this, in milliseconds.
DRIVER_STALE_AFTER_MS=600000

# How often the dashboard re-checks subscribed-but-silent drivers, in milliseconds.
OFFLINE_SWEEP_INTERVAL_MS=60000

# How often expired tokens and dead driver rows are evicted, in milliseconds.
STORE_CLEANUP_INTERVAL_MS=60000

# Maximum accepted request body.
JSON_BODY_LIMIT=16kb

# Minimum log level: silent | error | warn | info | debug
LOG_LEVEL=info
